# --- database -------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/careloop
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/careloop
MONGODB_URI="mongodb+srv://swaphublink:beyourself@swaphub.ypnrkvi.mongodb.net/?appName=careloop"
MONGODB_DB="careloop"

# --- auth -----------------------------------------------------------------
# Any random 32+ char string. Generate one with:
#   node -e "console.log(require(String.fromCharCode(99,114,121,112,116,111)).randomBytes(32).toString(0+\"hex\"))"
JWT_SECRET="replace-with-a-random-32-character-secret"

# --- model provider -------------------------------------------------------
# Leave OPENAI_API_KEY empty to run on the deterministic mock provider.
# The app and the eval both work without a key; the numbers are just not real.
OPENAI_API_KEY=""
OPENAI_MODEL_FAST="gpt-4o-mini"
OPENAI_MODEL_STRONG="gpt-4o"

PORT=3000

# --- networking (optional) -------------------------------------------------
# Only needed if your resolver refuses DNS SRV lookups, which makes
# mongodb+srv:// fail with "querySrv ECONNREFUSED". Leave unset otherwise.
# DNS_SERVERS="1.1.1.1,8.8.8.8"
